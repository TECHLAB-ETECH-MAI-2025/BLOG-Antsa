{% extends 'base.html.twig' %}

{% block title %}Modifier le commentaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Modifier le commentaire</h1>

    <div class="card shadow-sm">
        <div class="card-body">
        {{ include('comment/_form.html.twig', {'button_label': 'Mettre à jour', 'attr': {'novalidate': 'novalidate'}}) }} 
        </div>
    </div>

    <div class="mt-5 d-flex justify-content-between align-items-center">
        <a href="{{ path('app_comment_index') }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>

        
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card {
            max-width: 600px;
            margin: 0 auto;
        }
    </style>
{% endblock %}
