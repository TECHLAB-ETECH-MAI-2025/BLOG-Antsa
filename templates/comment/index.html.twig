{% extends 'base.html.twig' %}

{% block title %}Liste des commentaires{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Listes de commentaires</h1>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Auteur</th>
                <th scope="col">Contenu</th>
                <th scope="col">Date de création</th>
                <th scope="col" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for comment in comments %}
            <tr>
                <td>{{ comment.id }}</td>
                <td>{{ comment.author }}</td>
                <td>{{ comment.content|length > 50 ? comment.content|slice(0, 50) ~ '...' : comment.content }}</td>
                <td>{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '—' }}</td>
                <td class="text-center">
                    <a href="{{ path('app_comment_show', {'id': comment.id}) }}" class="btn btn-outline-secondary me-2 px-3" title="Voir">
                    <i class="fas fa-eye"></i> Voir
                    </a>
                    <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-outline-warning px-3" title="Modifier">
                    <i class="fas fa-edit"></i> Modifier
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center fst-italic text-muted">Aucun commentaire trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(comments) }}
    </div>

</div>
{% endblock %}
