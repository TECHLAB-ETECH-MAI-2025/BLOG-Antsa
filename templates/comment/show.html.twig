{% extends 'base.html.twig' %}

{% block title %}Comment Details{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Détails du commentaire</h1>

        <div class="card">
            <div class="card-body">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <th scope="row" class="w-25">ID</th>
                            <td>{{ comment.id }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Auteur</th>
                            <td>{{ comment.author }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Contenu</th>
                            <td>{{ comment.content }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Créé le</th>
                            <td>{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : 'Non défini' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-between">
            <a href="{{ path('app_comment_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>

            <div class="d-flex gap-2">
                <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-primary">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>

                {{ include('comment/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}