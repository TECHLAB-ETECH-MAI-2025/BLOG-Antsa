{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <h2>List of article</h2>
    <table class="table table-bordered table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Content</th>
                <th>Category</th>
                <th>CreatedAt</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.title }}</td>
                <td>{{ article.content }}</td>
                <td>
                    {% for cat in article.categories %}
                        <span class="badge bg-primary">{{ cat.title }}</span>
                    {% endfor %}
                </td>
                <td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '' }}</td>
                <td>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}" class="btn btn-sm btn-info">View</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="btn btn-sm btn-warning">Modify</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">article introuvable</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
