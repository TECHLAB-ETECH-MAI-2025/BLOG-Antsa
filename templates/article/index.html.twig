{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4"> Liste des articles</h1>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Contenu</th>
                        <th>Catégorie</th>
                        <th>Créé le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td>{{ article.id }}</td>
                            <td>{{ article.title }}</td>
                            <td>
                                {{ article.content|length > 80 ? article.content|slice(0, 80) ~ '…' : article.content }}
                            </td>
                            <td>
                                {% if article.categories is not empty %}
                                    {% for category in article.categories %}
                                        {{ category.title }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <em>Aucune catégorie</em>
                                {% endif %}
                            </td>
                            <td>
                                {{ article.createdAt ? article.createdAt|date('d/m/Y H:i') : 'N/A' }}
                            </td>
                            <td>
                                <a href="{{ path('app_article_show', {'id': article.id}) }}" class="btn btn-sm btn-outline-primary">
                                    Voir
                                </a>
                                <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    Modifier
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">Aucun article trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="d-flex justify-content-center mt-3">
            {{ knp_pagination_render(articles) }}
        </div>

        <div class="mt-4 text-end">
            <a href="{{ path('app_article_new') }}" class="btn btn-outline-info">
                Ajouter
            </a>
        </div>
    </div>
{% endblock %}