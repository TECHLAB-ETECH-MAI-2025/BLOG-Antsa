{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
<div class="container mt-5">

    {# --- Titre de l'article --- #}
    <h1 class="mb-3">{{ article.title }}</h1>

    <p class="article-content">{{ article.content|nl2br }}</p>

    {% if article.category|length > 0 %}
    <div class="mb-4">
        <strong>Catégories :</strong>
        <ul class="list-inline mt-2">
            {% for category in article.category %}
                <li class="list-inline-item badge bg-info text-dark">{{ category.title }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}


    {# --- Section des commentaires --- #}
    <div class="mb-5">
        <h4>Commentaires ({{ article.comments|length }})</h4>

        {% if article.comments|length > 0 %}
            <ul class="list-group mb-3">
                {% for comment in article.comments %}
                    < $this->categories = new ArrayCollection();li class="list-group-item">
                        <strong>{{ comment.author }}:</strong><br>
                        {{ comment.content|nl2br }}
                        <div class="text-muted small">{{ comment.createdAt|date('d/m/Y H:i') }}</div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucun commentaire pour le moment. Soyez le premier à réagir !</p>
        {% endif %}
    </div>

    {# --- Formulaire pour ajouter un commentaire --- #}
    <div class="comment-form mb-5">
        <h4>Ajouter un commentaire</h4>

        {{ form_start(commentForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(commentForm.author, 'Auteur', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(commentForm.author, {'attr': {
                'class': 'form-control',
                'placeholder': 'Votre nom',
                'required': 'required'
            }}) }}
        </div>

        <div class="mb-3">
            {{ form_label(commentForm.content, 'Commentaire', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(commentForm.content, {'attr': {
                'class': 'form-control',
                'rows': 4,
                'placeholder': 'Votre commentaire',
                'required': 'required'
            }}) }}
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Commenter
        </button>

        {{ form_end(commentForm) }}
    </div>

    {# --- Bouton retour à la liste des articles --- #}
    <a href="{{ path('app_article_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>

</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .article-content {
            font-size: 1.1em;
            line-height: 1.7;
        }
        .comment-form {
            max-width: 800px;
            margin: 0 auto;
        }
    </style>
{% endblock %}
