{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
<div class="col">
    <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title fs-3">{{ article.title }}</h5>
            <p class="card-text text-muted small">
                {{ article.createdAt ? article.createdAt|date('d/m/Y H:i') : 'N/A' }}
            </p>
            <p class="card-text">
                {{ article.content }}
            </p>
            <p class="mt-auto">
                {% if article.categories is not empty %}
                    <span class="badge bg-secondary">
                        {{ article.categories|map(c => c.title)|join(', ') }}
                    </span>
                {% else %}
                    <span class="text-muted">Aucune catégorie</span>
                {% endif %}
            </p>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center">
            <button class="btn btn-sm like-btn {{ article.isLikedBy(app.user) ? 'btn-danger' : 'btn-outline-danger' }}" data-id="{{ article.id }}">
            <i class="bi {{ article.isLikedBy(app.user) ? 'bi-heart-fill text-danger' : 'bi-heart' }}"></i>
            <span class="like-count">{{ article.likes|length }}</span>
            </button>

            <a href="#commentaires" class="btn btn-outline-success btn-sm">
                <i class="bi bi-chat-left-text"></i> {{ article.comments|length }}
            </a>

            <div class="dropdown">
                <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" id="dropdownMenuButton{{ article.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton{{ article.id }}">
                    <li>
                        <a class="dropdown-item" href="{{ path('app_article_edit', {'id': article.id}) }}">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                    </li>
                    <li>
                        {{ include('article/_delete_form.html.twig', {'article': article}) }}
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .article-content {
            font-size: 1.1em;
            line-height: 1.7;
        }
        .comment-form {
            max-width: 800px;
            margin: 0 auto;
        }
    </style>
{% endblock %}
