<form method="post"
      action="{{ path('app_article_delete', {'id': article.id}) }}"
      onsubmit="return confirm(' Sûr de vouloir supprimer cet article ?');"
      style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
    <button type="submit" class="dropdown-item" style="border: none; background: none; padding: 0; color: inherit;">
    <i class="bi bi-trash"></i> Supprimer
    </button>
</form>