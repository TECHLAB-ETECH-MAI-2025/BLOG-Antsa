{% extends 'base.html.twig' %}

{% block title %}Profil Utilisateur{% endblock %}

{% block body %}
<style>
    body {
        background: #f9f5fb;
        color: #4b306a;
        font-family: 'Arial', sans-serif;
    }
    .profile-container {
        max-width: 600px;
        margin: 2rem auto;
        background: white;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(75, 48, 106, 0.15);
        text-align: center;
    }
    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin-bottom: 1rem;
    }
    h1 {
        margin-bottom: 0.5rem;
    }
    p {
        margin-bottom: 1rem;
    }
    a.btn {
        background:rgb(232, 19, 240);
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin: 0.5rem;
        display: inline-block;
        transition: background 0.3s ease;
    }
    a.btn:hover {
        background:rgb(245, 32, 181);
    }
</style>

<div class="profile-container">
    <!-- Avatar auto généré -->
    <img src="https://ui-avatars.com/api/?name={{ app.user.firstName }}+{{ app.user.lastName }}
        &background=91467a&color=fff&size=128&rounded=true"
         alt="Avatar"
         class="profile-avatar">

    <h1>Bonjour {{ app.user.getFullName() }}</h1>
    <p><strong>Email :</strong> {{ app.user.email }}</p>

    <a href="{{ path('app_profile_edit') }}" class="btn">Modifier</a>
</div>
{% endblock %}
